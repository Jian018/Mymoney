NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical ledger owner UUID returned by setup-device.sql; remains stable across device replacements.
ALLOWED_USER_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_EMAIL
# Server only: scheduled reminders and optional PayPal authorization metadata.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: own LIVE PayPal Business app with Transaction Search scope. Never NEXT_PUBLIC_.
# Personal accounts cannot use this API. Leave disabled to use statement import.
PAYPAL_BUSINESS_API_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CRON_SECRET=
