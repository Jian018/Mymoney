NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical ledger owner UUID returned by setup-device.sql; remains stable across device replacements.
ALLOWED_USER_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_EMAIL
# Server only: reminders and encrypted Gmail authorization. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Exact production HTTPS origin (no trailing path). Use a stable custom/production URL.
APP_URL=https://YOUR_APP.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=
# Public privacy/contact page should identify your real support address.
APP_SUPPORT_EMAIL=
